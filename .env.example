# LocalLift configuration. Copy to .env and fill in what you have.
# Secrets stay server-side; never commit .env.

# --- Runtime -----------------------------------------------------------
# live = real sources only. test = deterministic fixtures in a separate DB.
LOCALLIFT_ENV=live
LOCALLIFT_DB=data/locallift.db
LOCALLIFT_TEST_DB=data/test.db
# Contact string sent in the User-Agent header to public APIs (be polite).
LOCALLIFT_CONTACT=LocalLift class project (contact: owner@example.com)

# --- Events ------------------------------------------------------------
# Free key: https://developer-acct.ticketmaster.com/user/register  (see README)
TICKETMASTER_API_KEY=

# --- Social ------------------------------------------------------------
# Optional. Only needed if unauthenticated Bluesky search is refused.
# Create an app password at https://bsky.app/settings/app-passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Twitter/X. Requires a developer app bearer token (https://developer.x.com).
# As of 2026 X reads are billed pay-per-use, so the adapter stays OFF unless
# ENABLE_PAID_SOURCES=true AND X_MONTHLY_BUDGET_USD > 0.
X_BEARER_TOKEN=
# Or the app's consumer keys (API Key / API Key Secret); exchanged for a bearer token at startup.
X_API_KEY=
X_API_SECRET=
X_MONTHLY_BUDGET_USD=0
# Reference price used for the local spend guard (check docs.x.com pricing).
X_COST_PER_POST_READ_USD=0.005
X_MAX_POSTS_PER_QUERY=10
# Once-a-day X sample for this many top picks, plus manual "Check news & buzz" clicks.
X_DAILY_EVENTS=2
# Never sample the same event on X more often than this (hours).
X_MIN_HOURS_BETWEEN=6
# The counts endpoint returns total matching posts per hour (real volume, not a sample). In testing it did not
# consume post-read quota; a conservative per-call estimate is booked against the cap.
X_COUNTS_COST_USD=0.01
# On = X trend shows real 24h-vs-24h volume.
X_INCLUDE_COUNTS=false

# Paid connectors are never enabled silently.
ENABLE_PAID_SOURCES=false

# --- Agent model ---------------------------------------------------------
# MODEL_PROVIDER = none | anthropic | openai_compatible
MODEL_PROVIDER=none

# Anthropic (paid API usage; a Claude.ai subscription does NOT cover it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Explicit so a stray ANTHROPIC_BASE_URL in your shell is not picked up.
LOCALLIFT_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible endpoint with tool calling. Free-tier examples:
#   Google Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/   model gemini-3.5-flash
#   Groq:           https://api.groq.com/openai/v1                             model llama-3.3-70b-versatile
#   Ollama (local): http://localhost:11434/v1                                  model qwen2.5:7b  (key: ollama)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Tried in order when the main model is overloaded (503/429) or times out.
OPENAI_COMPAT_FALLBACK_MODELS=

# Optional second provider: Groq free tier, used automatically when every Gemini model is out of quota/busy.
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Spend guard for the model (USD/day). Prices per million tokens are used to
# estimate cost; leave at 0 for free tiers / local models.
MAX_DAILY_MODEL_COST=2.00
MODEL_INPUT_COST_PER_MTOK=0
MODEL_OUTPUT_COST_PER_MTOK=0
# Investigation budget per opportunity.
AGENT_MAX_RETRIEVALS=8
AGENT_MAX_SECONDS=60
AGENT_MAX_TURNS=12

# --- Map ---------------------------------------------------------------
# Any OSM-compatible XYZ template. Standard OSM tiles (light use only); the UI darkens them with a CSS filter.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Approved hosts for fetchApprovedSource (comma separated) ------------
APPROVED_FETCH_HOSTS=www.ticketmaster.com,www.msg.com,www.nycgovparks.org,gothamist.com,www.nyc.gov,new.mta.info,www.livenation.com,www.hudsonyardsnewyork.com,www.bryantpark.org,www.koreatownnyc.org
